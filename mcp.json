{
  "mcpServers": {
    "homelab-functions": {
      "type": "stdio",
      "command": "python3",
      "args": ["-m", "homelab.mcp_server"],
      "cwd": "${CURSOR_PLUGIN_ROOT}",
      "env": {
        "HOMELAB_FUNCTIONS_URL": "${HOMELAB_FUNCTIONS_URL}",
        "HOMELAB_FUNCTIONS_TOKEN": "${HOMELAB_FUNCTIONS_TOKEN}"
      }
    }
  }
}
